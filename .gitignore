.venv/

# IDF 组件管理器按 dependencies.lock 自动拉取，不入库
managed_components/
# esp-sr 构建时从 components/esp-sr/model 复制生成的模型分区内容
target/
# 会话运行时状态（pid 文件等）
.superpowers/
