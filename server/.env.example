# 复制为 .env 后填写真实值
# 阶跃星辰（StepFun）—— 对话与 TTS 主服务
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_CHAT_MODEL=stepaudio-2.5-chat
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_TTS_VOICE=qingchunshaonv
STEPFUN_REALTIME_MODEL=stepaudio-2.5-realtime
STEPFUN_REALTIME_VOICE=qingchunshaonv
STEPFUN_VAD_SILENCE_MS=800

# 语音合成：StepFun 不可用时回退的 TTS
TTS_BACKEND=stepfun                 # stepfun | edge | mock
TTS_VOICE=zh-CN-XiaoxiaoNeural     # 微软 Edge TTS 默认中文女声（仅 edge 用）

# 云端 ASR（语音转文字）—— 具体厂商待确认
# 可插拔接口，先按所选厂商填入配置
ASR_BACKEND=mock                    # mock | aliyun | xfyun | baidu | openai
ASR_API_KEY=
ASR_APP_ID=
ASR_SECRET_KEY=

# 服务器监听（设备经局域网访问）
HOST=0.0.0.0
PORT=5000
# 供设备拉流用的本机局域网地址；留空则自动探测
LAN_IP=

# ---- 情感陪伴与多设备记忆 ----
# 人设提示词：留空用内置的"温柔陪伴伙伴"人格。
# 想换风格（如猫娘、管家、树洞）在此覆盖，对所有设备生效。
VIRTUAL_COMPANION_PROMPT=
# 每台设备（device_id）独立记忆，存于 server/memory/<device_id>.json
# 短期历史保留轮数（每轮 user+assistant）
MEMORY_MAX_TURNS=12
# 历史超过该轮数时触发长期记忆提炼（预留）
MEMORY_SUMMARIZE_TURNS=24
